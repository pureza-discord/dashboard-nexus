# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------
APP_NAME=Nexus Leads SaaS API
APP_ENV=development
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Database / Queue
# -----------------------------------------------------------------------------
# Production: postgresql+psycopg://user:pass@host:5432/db
DATABASE_URL=sqlite:///data/dev.db
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=memory://
CELERY_RESULT_BACKEND=cache+memory://
CELERY_TASK_ALWAYS_EAGER=true

# -----------------------------------------------------------------------------
# Auth / Security
# -----------------------------------------------------------------------------
JWT_SECRET_KEY=change-this-to-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
EMAIL_CODE_TTL_MINUTES=15

# -----------------------------------------------------------------------------
# CORS / Frontend
# -----------------------------------------------------------------------------
FRONTEND_DIST=frontend/dist
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000,http://127.0.0.1:8000
CORS_ALLOW_CREDENTIALS=true

# -----------------------------------------------------------------------------
# AI
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
ENABLE_EXTERNAL_DATA=true
TRENDS_GEO_DEFAULT=BR

# -----------------------------------------------------------------------------
# Email (Resend)
# In APP_ENV=development, if RESEND_API_KEY is empty or fails, code is logged.
# -----------------------------------------------------------------------------
RESEND_API_KEY=
RESEND_FROM_EMAIL=
SMTP_FROM_EMAIL=

# -----------------------------------------------------------------------------
# Lead Providers
# -----------------------------------------------------------------------------
SCRAPER_MODE=outscraper
OUTSCRAPER_API_KEY=
SERPAPI_API_KEY=

# -----------------------------------------------------------------------------
# Bootstrap admin
# -----------------------------------------------------------------------------
AUTO_BOOTSTRAP_ADMIN=true
BOOTSTRAP_ADMIN_EMAIL=admin@nexus.local
BOOTSTRAP_ADMIN_PASSWORD=admin123

# -----------------------------------------------------------------------------
# Billing / payment integrations
# -----------------------------------------------------------------------------
ASAAS_API_BASE_URL=https://api.asaas.com/v3
ASAAS_API_KEY=
ASAAS_WEBHOOK_TOKEN=
PLAN_PRICE_BASIC_BRL=79
PLAN_PRICE_PRO_BRL=199
PLAN_PRICE_ENTERPRISE_BRL=799
CREDIT_PRICE_PER_UNIT_BRL=1

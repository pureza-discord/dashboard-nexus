# ============================================================================
# NexusCoding Leads Scraper Dashboard — Environment Variables
# ============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ============================================================================

# --- Application ---
APP_NAME="Nexus Leads SaaS API"
APP_ENV=development                   # development | production
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO                        # DEBUG | INFO | WARNING | ERROR
FRONTEND_DIST=frontend/dist           # Path to built frontend assets

# --- Database ---
# SQLite for dev, PostgreSQL for production
# DATABASE_URL=sqlite:///data/dev.db
# DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/nexus_leads

# --- Redis & Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=                    # Defaults to REDIS_URL
CELERY_RESULT_BACKEND=               # Defaults to REDIS_URL/1
CELERY_TASK_ALWAYS_EAGER=true        # true for dev (no Redis needed), false for prod

# --- Authentication ---
JWT_SECRET_KEY=                       # REQUIRED in production. Auto-generated in dev.
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440      # 24 hours

# --- CORS ---
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8000
CORS_ALLOW_CREDENTIALS=true

# --- Scraper ---
SCRAPER_MODE=google_maps             # google_maps | mock (mock for testing only)
ENABLE_EXTERNAL_DATA=true
TRENDS_GEO_DEFAULT=BR                # Default Google Trends geo region

# --- Email Verification (Resend) ---
# Sign up at https://resend.com — free tier supports 100 emails/day
RESEND_API_KEY=                       # Required for email verification to work
SMTP_FROM_EMAIL="NexusCoding <onboarding@resend.dev>"

# --- Email Verification Settings ---
EMAIL_CODE_TTL_MINUTES=5             # Verification code expiry

# --- Admin Bootstrap ---
AUTO_BOOTSTRAP_ADMIN=true
BOOTSTRAP_ADMIN_EMAIL=admin@nexus.local
BOOTSTRAP_ADMIN_PASSWORD=admin123             

# --- Billing (Mercado Pago) ---
MERCADO_PAGO_ACCESS_TOKEN=           # Get from https://www.mercadopago.com.br/developers
# ASAAS_API_BASE_URL=https://api.asaas.com/v3
# ASAAS_API_KEY=
# ASAAS_WEBHOOK_TOKEN=

# --- Billing (Stripe — Optional) ---
STRIPE_SECRET_KEY=                    # Get from https://dashboard.stripe.com/apikeys
STRIPE_WEBHOOK_SECRET=               # Get from Stripe Dashboard > Webhooks
STRIPE_SUCCESS_URL=http://localhost:5173/account?payment=success
STRIPE_CANCEL_URL=http://localhost:5173/account?payment=cancelled

# --- Plan Pricing (BRL) ---
PLAN_PRICE_BASIC_BRL=79.0
PLAN_PRICE_PRO_BRL=199.0
PLAN_PRICE_ENTERPRISE_BRL=799.0
CREDIT_PRICE_PER_UNIT_BRL=1.0

# --- Scraping Delays (anti-detection) ---
DELAY_MIN=1.8
DELAY_MAX=6.0

# --- LinkedIn / Facebook (Optional API keys) ---
LINKEDIN_API_KEY=                     # LinkedIn Sales Navigator API key
FACEBOOK_APP_ID=                      # Facebook App ID
FACEBOOK_APP_SECRET=                  # Facebook App Secret
